#!/usr/bin/env bash
set -euo pipefail
# Resolve the entry point even when installed as a symlink in ~/.local/bin.
entry="${BASH_SOURCE[0]}"
while [ -L "$entry" ]; do
  base="$(cd -P "$(dirname "$entry")" && pwd)"
  entry="$(readlink "$entry")"
  [[ "$entry" = /* ]] || entry="$base/$entry"
done
tool_dir="$(cd -P "$(dirname "$entry")" && pwd)"
export UV_PROJECT_ENVIRONMENT="${SKETCH_AUDIO_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/sketch-visualization}/venv"
if [[ -n "${SKETCH_AUDIO_PYTHON:-}" ]]; then
  exec "$SKETCH_AUDIO_PYTHON" "$tool_dir/audio/cli.py" "$@"
fi
if [[ "${1:-}" = doctor || "${1:-}" = check ]] && [[ -x "$UV_PROJECT_ENVIRONMENT/bin/python" ]]; then
  exec "$UV_PROJECT_ENVIRONMENT/bin/python" "$tool_dir/audio/cli.py" "$@"
fi
if [[ "${1:-}" = doctor ]]; then
  printf '%s\n' '{"speech_ready":false,"reference_ready":false,"aligner":false,"verified":false,"ffmpeg":null,"reason":"Run sketch-audio setup to prepare local voice"}'
  exit 0
fi
export TOKENIZERS_PARALLELISM=false
export PYTHONDONTWRITEBYTECODE=1
exec uv run --quiet --locked --project "$tool_dir" python "$tool_dir/audio/cli.py" "$@"
