{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@visual-storytelling/core": ["./src/index.ts"],
      "@visual-storytelling/core/three": ["./src/viewport/index.ts"],
      "@visual-storytelling/core/*": ["./src/*/index.ts"],
      "@visual-storytelling/core/physics/2d": ["./src/physics/2d.ts"],
      "@visual-storytelling/core/physics/3d": ["./src/physics/3d.ts"]
    },
    "allowJs": true
  },
  "include": ["src", "examples", "tests", "vite.config.ts", "playwright.config.ts"]
}
