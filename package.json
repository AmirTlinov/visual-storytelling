{
  "name": "@visual-storytelling/core",
  "version": "0.18.6",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "description": "Carefully hand-drawn, deterministic visual explanations.",
  "files": [
    "dist",
    "tools",
    "examples/**/*.{html,js,mjs,ts,json,css,svg,png,jpg,webp,woff2,py,txt,md,command}",
    "!examples/**/{dist,site,artifacts,review,node_modules}/**",
    "!examples/**/.*",
    "!examples/**/.*/**",
    "skills",
    "docs",
    "PHILOSOPHY.md",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY.md",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ink": {
      "types": "./dist/ink/index.d.ts",
      "import": "./dist/ink/index.js"
    },
    "./story": {
      "types": "./dist/story/index.d.ts",
      "import": "./dist/story/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "import": "./dist/recipes/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./style.css": "./dist/style.css",
    "./three": {
      "types": "./dist/viewport/index.d.ts",
      "import": "./dist/viewport/index.js"
    },
    "./physics": {
      "types": "./dist/physics/index.d.ts",
      "import": "./dist/physics/index.js"
    },
    "./physics/2d": {
      "types": "./dist/physics/2d.d.ts",
      "import": "./dist/physics/2d.js"
    },
    "./physics/3d": {
      "types": "./dist/physics/3d.d.ts",
      "import": "./dist/physics/3d.js"
    },
    "./characters": {
      "types": "./dist/characters/index.d.ts",
      "import": "./dist/characters/index.js"
    },
    "./book": {
      "types": "./dist/book/index.d.ts",
      "import": "./dist/book/index.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "./examples/**"
  ],
  "scripts": {
    "dev": "node tools/dev-gallery.mjs",
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:tools": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "playwright test",
    "test:delivery": "node tools/check-delivery.mjs",
    "preview": "node tools/scene.mjs preview site --port 8793",
    "export": "node tools/export.mjs",
    "previews": "node tools/previews.mjs",
    "profile": "node tools/profile.mjs",
    "format": "prettier --write src examples tools tests *.ts *.json README.md PHILOSOPHY.md AGENTS.md THIRD_PARTY.md docs",
    "prepack": "npm run build",
    "test:visual": "node tools/visual-regression.mjs compare site artifacts/migrated",
    "build:characters": "node tools/characters/build-builtin.mjs",
    "build:plugin": "node plugin/build.mjs",
    "plugin:release": "npm run build && node plugin/build.mjs --release"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@dimforge/rapier2d-compat": "0.21.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@esotericsoftware/spine-webgl": "4.3.13",
    "@types/three": "0.183.1",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "mathjs": "15.2.0",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "roughjs": "4.6.6",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@openai/mcp-extensions": "0.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "visual-story": "tools/scene.mjs",
    "sketch-audio": "tools/sketch-audio",
    "visual-story-export": "tools/export.mjs"
  }
}
